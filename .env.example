APP_NAME=Moon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FALLBACK_LOCALE_LIST=es,en
APP_THEME=aeris

# ---------------------------------------------------------------------------
# Base de datos PROPIA del CMS (usuarios del panel, reinos, modulos, etc).
# Nunca se usa para autenticar el juego: eso vive en la BD "auth" de cada
# reino y se resuelve dinamicamente vía la tabla `realms` (ver README).
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=moon_cms
DB_USERNAME=moon
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Redis: colas (aprovisionamiento de cuentas de juego, envio de correos,
# sincronizacion de contraseña) y cache.
# ---------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Correo: verificacion de cuenta y recuperacion de contraseña.
# En local, Mailhog (http://localhost:8025) captura todo lo enviado.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@moon.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Aprovisionamiento de cuentas de juego (Jobs en cola).
# ---------------------------------------------------------------------------
GAME_ACCOUNT_PROVISIONING_MAX_ATTEMPTS=5
GAME_ACCOUNT_PROVISIONING_BACKOFF_SECONDS=5,15,30,60,120

VITE_APP_NAME="${APP_NAME}"
